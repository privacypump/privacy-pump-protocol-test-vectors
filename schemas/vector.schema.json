{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schemaVersion",
      "id",
      "class",
      "description",
      "input",
      "expected",
      "provenance"
    ],
    "properties": {
      "schemaVersion": {
        "const": 1
      },
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      },
      "class": {
        "type": "string",
        "minLength": 1
      },
      "description": {
        "type": "string",
        "minLength": 1
      },
      "input": {
        "type": "object"
      },
      "expected": {
        "type": "object"
      },
      "provenance": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
